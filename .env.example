# eBay Developer keyset (https://developer.ebay.com/my/keys)
#
# Production credentials use a "PRD" prefix, sandbox uses "SBX".
# The two keysets are separate; do not mix sandbox CLIENT_ID with
# production CLIENT_SECRET or vice versa.
EBAY_CLIENT_ID=your_app_id_here
EBAY_CLIENT_SECRET=your_cert_id_here

# Marketplace: EBAY_GB, EBAY_US, EBAY_DE, EBAY_FR, EBAY_IT, EBAY_ES, EBAY_AU, etc.
EBAY_MARKETPLACE=EBAY_GB

# Environment: "sandbox" or "production".
# Start with sandbox to verify your integration without approval friction.
# Switch to "production" once your production keyset is enabled for OAuth
# and you have either set up the marketplace account deletion notification
# endpoint or obtained an exemption.
EBAY_ENV=sandbox
